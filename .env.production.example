# Salin file ini menjadi .env di direktori deploy VPS (DEPLOY_PATH).
# .env gitignored — tidak ikut versi, tidak ikut CI.
# Default di komentar sama dengan default docker-compose.prod.yml.

# ---------- PostgreSQL ----------
DB_USER=bandjari
DB_PASSWORD=GANTI_PASSWORD_STRONG
DB_NAME=bandjari
# DB_PORT=5432
SSL_MODE=disable

# ---------- JWT (WAJIB diisi) ----------
# Ganti dengan string acak panjang. Bila berubah, semua token lama tidak valid.
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG

# ---------- Object storage: Cloudflare R2 (S3-compatible) ----------
# 1. Buat bucket di dashboard R2, mis. "bandjari-samples".
# 2. R2 → Manage R2 API Tokens → Create token dengan permission
#    "Object Read & Write" (bucket itu saja cukup).
# 3. Isi endpoint dengan ACCOUNT_ID dari dashboard R2.
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=bandjari-samples
STORAGE_ACCESS_KEY_ID=GANTI_ACCESS_KEY_ID_R2
STORAGE_SECRET_ACCESS_KEY=GANTI_SECRET_ACCESS_KEY_R2
# STORAGE_USE_PATH_STYLE=true   # default true — wajib untuk R2/MinIO

# ---------- Auth: email (SMTP Brevo) ----------
# Verifikasi/reset password. Syarat: domain bandjari.net authenticated di Brevo
# (SPF/DKIM di Cloudflare) + whitelist IP VPS di dashboard Brevo (SMTP & API).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=GANTI_EMAIL_LOGIN_BREVO
SMTP_PASSWORD=GANTI_SMTP_KEY_BREVO
SMTP_FROM_EMAIL=no-reply@bandjari.net

# ---------- Auth: OAuth & origin ----------
# APP_BASE_URL — origin frontend (link email verifikasi/reset + redirect OAuth)
APP_BASE_URL=https://bandjari.net
# JWT_ISSUER — klaim iss access token (default sudah sama di compose)
JWT_ISSUER=https://api.bandjari.net
GOOGLE_CLIENT_ID=GANTI_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GANTI_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL=https://api.bandjari.net/api/v1/auth/google/callback
